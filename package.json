{
  "name": "keep",
  "version": "1.8.2",
  "scripts": {
    "ng": "ng",
    "start": "concurrently \"npm run api\" \"npm run client\"",
    "client": "set NG_SASS_VERBOSE_DEPRECATIONS=0&& ng serve --host 0.0.0.0 --port 6767 --proxy-config proxy.conf.json",
    "api": "nodemon --no-deprecation server/server.js",
    "build": "ng build && npm run purgecss",
    "test:sync": "node server/sync-smoke.test.js",
    "test:offline-sync-status": "node --test scripts/offline-sync-status.test.cjs",
    "test:uuid": "node --test src/app/utils/uuid.test.ts",
    "test:uuid:http": "node scripts/uuid-http-test.mjs",
    "test:native": "node server/native-client.test.js",
    "test:native-signout": "node --test scripts/native-signout.test.cjs",
    "test:reminders": "node --test server/reminder-recurrence.test.js",
    "mcp": "node mcp/index.mjs",
    "test:mcp": "node --test mcp/*.test.mjs",
    "purgecss": "purgecss -c purgecss.config.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "analyze": "webpack-bundle-analyzer dist/keep/stats.json",
    "docker:deploy": "npx tsx ./deploy-docker-images.ts",
    "test:note-html": "node --test server/note-html.test.js",
    "test:note-html:ui": "node scripts/note-html-ui-test.mjs",
    "test:browser-session": "node --test server/browser-session.test.js server/url-credentials.test.js",
    "test:browser-session:ui": "node scripts/browser-session-test.mjs",
    "test:proxy-image": "node --test server/image-proxy.test.js",
    "test:proxy-image:browser": "node scripts/proxy-image-browser-test.mjs",
    "test:workspaces": "node --test scripts/workspace-store.test.cjs scripts/native-workspace.test.cjs scripts/offline-sync-status.test.cjs server/workspace-sync.test.js",
    "test:workspaces:browser": "node scripts/workspace-browser-test.mjs"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "dependencies": {
    "@angular/animations": "^21.2.12",
    "@angular/common": "^21.2.12",
    "@angular/compiler": "^21.2.12",
    "@angular/core": "^21.2.12",
    "@angular/forms": "^21.2.12",
    "@angular/platform-browser": "^21.2.12",
    "@angular/platform-browser-dynamic": "^21.2.12",
    "@angular/router": "^21.2.12",
    "@capacitor/core": "^8.3.4",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@noble/hashes": "2.4.0",
    "@popperjs/core": "^2.11.5",
    "@types/jszip": "^3.4.0",
    "@zip.js/zip.js": "2.24.0",
    "adm-zip": "^0.5.16",
    "bricks.js": "^1.8.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "csrf-sync": "^4.2.1",
    "dompurify": "^3.4.17",
    "express": "^4.22.1",
    "express-session": "^1.19.0",
    "jszip": "^3.10.1",
    "multer": "^2.1.1",
    "node-snackbar": "^0.1.16",
    "openid-client": "^6.8.8",
    "otplib": "^13.4.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.5.0",
    "sanitize-html": "^2.18.0",
    "sqlite3": "^6.0.1",
    "timepicker-ui": "^4.3.0",
    "tslib": "^2.3.0",
    "unzipper": "^0.12.3",
    "web-push": "^3.6.7",
    "ws": "^8.20.0",
    "zod": "^3.25.76",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.10",
    "@angular/cli": "~21.2.10",
    "@angular/compiler-cli": "^21.2.12",
    "@types/jasmine": "~4.0.0",
    "fake-indexeddb": "6.2.4",
    "jasmine-core": "~4.1.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.0.0",
    "karma-jasmine-html-reporter": "~1.7.0",
    "nodemon": "^3.1.9",
    "playwright": "^1.64.1",
    "purgecss": "^4.1.3",
    "typescript": "~5.9.3",
    "webpack-bundle-analyzer": "^4.6.1"
  }
}
