  "styles": {
    "color": "^(?:#[0-9a-f]{3,8}|[a-z]+|(?:rgb|hsl)a?\\([0-9.,% /+-]+\\))$",
    "background-color": "^(?:#[0-9a-f]{3,8}|[a-z]+|(?:rgb|hsl)a?\\([0-9.,% /+-]+\\))$",
    "font-weight": "^(?:normal|bold|bolder|lighter|[1-9]00)$",
    "font-style": "^(?:normal|italic|oblique)$",
    "font-size": "^(?:[0-9.]+(?:px|em|rem|%)|xx-small|x-small|small|medium|large|x-large|xx-large|smaller|larger)$",
    "font-family": "^[a-z0-9 ,_'\"-]+$",
    "text-decoration": "^(?:none|underline|line-through|overline)(?: (?:underline|line-through|overline))*$",
    "text-align": "^(?:left|right|center|justify|start|end)$",
    "white-space": "^(?:normal|pre|pre-wrap|pre-line|break-spaces)$",
    "vertical-align": "^(?:baseline|sub|super|middle|top|bottom|text-top|text-bottom)$",
    "line-height": "^(?:normal|[0-9.]+(?:px|em|rem|%)?)$",
    "margin-left": "^[0-9.]+(?:px|em|rem|%)$",
    "padding-left": "^[0-9.]+(?:px|em|rem|%)$",
    "width": "^(?:auto|[0-9.]+(?:px|em|rem|%))$",
    "height": "^(?:auto|[0-9.]+(?:px|em|rem|%))$",
    "max-width": "^(?:none|[0-9.]+(?:px|em|rem|%))$"
  }
